{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "useUnknownInCatchVariables": true
    },
    "include": [
        "app/**/*.ts",
        "app/**/*.vue",
        "server/**/*.ts",
        "server/**/*.d.ts",
        "nuxt.config.ts",
        "vitest.config.ts",
        "playwright.config.ts"
    ]
}